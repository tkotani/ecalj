#!/usr/bin/env python3
import os
import re
import shutil
import argparse
import sys
from pathlib import Path
from pylib.utils import ensure_dir, remove_files, copy_files, move_files
from pylib.run_cmd import run_cmd, start_cmd, finish_cmd, MPIParams
from pylib.dft import run_lmf

EXEC_DIR = Path(__file__).parent

parser = argparse.ArgumentParser(prog='gwsc',description='''
  QSGW calculation with MPI.
  gwsc allow general options (not described here), which are used in cmdopt in *.f90'
''')
parser.add_argument("nloop",       help='number of QSGW iteration, starting from current result.',default=1,type=int)
parser.add_argument("extension",   help='<sname> of ctrlg.<sname>.toml')
parser.add_argument("-np",         help='number of mpi cores in lmf',default=8,type=int)
parser.add_argument("-ppn",        help='number of mpi cores per node',default=None,type=int)
parser.add_argument("-np2", "-npgpu", help='number of mpi cores in GPU calculation', type=int, default=None) 
parser.add_argument("-ppn2", "-ppngpu", help='number of mpi cores per node',default=None,type=int)
parser.add_argument('--phispinsym',help='spin-symmetrized augmentation: the same as --ctrlg:ham.phispinsym=true '
                    '(or [ham] phispinsym = true in ctrlg.<sname>.toml)',action='store_true')
parser.add_argument('--emptyrun'  ,help='test for gprof for memory',    action='store_true')
parser.add_argument('--gpu'       ,help='USE GPU versions of the GW programs (hvccfp0, hsfp0_sc, hgw)',    action='store_true')
parser.add_argument('--gemmul8'   ,help='USE GEMMul8 valid in GPU without MP',    action='store_true')
parser.add_argument('--prec'      ,help='precision of the GW programs: fp64 (double precision), fp32 (mixed precision, '
                    'FP32 products; = --mp --fp32) or tf32 (as fp32, but the Sigma_c products on GPU with 10-bit-mantissa '
                    'inputs, TF32 or FP16: faster, Sigma slightly less accurate). How each GPU product is done is read from '
                    '<bindir>/ecalj_linalg_policy.toml (written by linalgtune). --mp alone = tf32 (before 2026-09-27 '
                    '--mp meant TF32 in every product).',
                    choices=['tf32', 'fp32', 'fp64'], default=None)
parser.add_argument('--prec-final', help='precision of the last iterations of this run, <prec>[:N] (N=1 if omitted): e.g. '
                    '--prec=tf32 --prec-final=fp32:2 runs all but the last two iterations in tf32 and those in fp32',
                    default=None)
parser.add_argument('--mp'        ,help='mixed precision versions of the GW programs; older spelling of --prec: '
                    '--mp alone = --prec=tf32, --mp --fp32 = --prec=fp32',    action='store_true')
parser.add_argument('--fp32'      ,help='With --mp: FP32 also in the Sigma_c products (= --prec=fp32)', action='store_true')
parser.add_argument('--no-tetwt-helper', help='with --gpu: compute the tetrahedron weights inside hgw instead of '
                    'in a CPU helper run (hgw --tetwt_write on -np cores next to hgw)', action='store_true')
parser.add_argument('--dumpW',     help='Persist screened Coulomb W-V to __WVR.<iq>/__WVI.<iq> (combined hgw SHM dump) for analysis', action='store_true')
parser.add_argument('--WVR2ptRaxis', help='Sc real-axis (WVR) pole term: 2-point LINEAR Wc(we) interpolation (alagr2zz, no negative-weight overshoot) instead of 3-point Lagrange', action='store_true')
parser.add_argument("-c", "--cluster", help="cluster name", default="default", type=str)
args,unknown=parser.parse_known_args()

target=args.extension                            # si, ctrlg.si.toml, or ctrl.si (the legacy file name)
_m=re.fullmatch(r'ctrlg\.(.+)\.toml',target)     # (Bug fixed 2026-09-30 01:35: ctrlg.si.toml became '.si.toml')
if _m: target=_m.group(1)
elif target.startswith('ctrl.'): target=target[5:]
if args.prec is not None:     # --prec is the one switch; --mp/--fp32 are its older spelling
    if (args.mp and args.prec == 'fp64') or (args.fp32 and args.prec != 'fp32'):
        raise SystemExit(f'gwsc: --prec={args.prec} contradicts --mp/--fp32; give only --prec.')
    args.mp = args.prec != 'fp64'
    args.fp32 = args.prec == 'fp32'
cluster = args.cluster
nloop = args.nloop
base_prec = args.prec or ('fp64' if not args.mp else ('fp32' if args.fp32 else 'tf32'))   # --mp alone = tf32
final_prec, nfinal = None, 0
if args.prec_final is not None:      # the last nfinal iterations of this run in another precision
    final_prec, _, _n = args.prec_final.partition(':')
    nfinal = int(_n) if _n else 1
    if final_prec not in ('tf32', 'fp32', 'fp64') or nfinal < 1:
        raise SystemExit(f'gwsc: --prec-final={args.prec_final}: expected tf32|fp32|fp64[:N], N >= 1.')

#number of MPI process
ncore = args.np
ncore2 = args.np2 if args.np2 is not None else args.np

#number of MPI per node
npernode = args.ppn
npernode2 = args.ppn2 if args.ppn2 is not None else args.ppn

# Define MPI parameter sets for different parts of the calculation
mpi_params_lmf = {"nprocs": ncore, "npernode": npernode}
mpi_params_gw = {"nprocs": ncore2, "npernode": npernode2}
mpi_params_single = {"nprocs": 1, "npernode": None}

options = []   # the precision options (--use_fp32, --sigma_tf32) and exec_type are set per iteration in the loop
if args.phispinsym:   # (Bug fixed 2026-09-30 02:15: '--phispinsym' itself went to the programs, which stop on it since 2026-06)
    options.append("--ctrlg:ham.phispinsym=true")
if args.emptyrun:
    options.append("--emptyrun")
if args.dumpW:
    options.append("--dumpW")
if args.WVR2ptRaxis:
    options.append("--WVR2ptRaxis")
if args.gemmul8:
    options.append("--use_gemmul8")
    libpath = Path(__file__).parent / "libgemmul8.so"
    os.environ["LD_PRELOAD"] = str(libpath)
    if not libpath.is_file():
        raise FileNotFoundError(f"{libpath} does not exist.")

options.extend(unknown)
print('--- Start gwsc ---')
print('option=',options)

# Ensure ctrlg.<target>.toml exists before launching any binary (it carries the
# GW sections too; the per-atom product-basis tables moved into it from
# PB.<target>.toml in 2026-09). Fortran binaries are TOML-only (no
# auto-conversion): run Legacy2toml.py beforehand for legacy ctrl+GWinput.
import os.path as _op
_ctrlg = f'ctrlg.{target}.toml'
if not _op.isfile(_ctrlg):
    print(f'gwsc: missing {_ctrlg} in cwd.', file=sys.stderr)
    print('       Run Legacy2toml.py to convert legacy ctrl+GWinput to TOML form.', file=sys.stderr)
    raise SystemExit(2)
print(f'gwsc: using {_ctrlg} (TOML mode)')

## MLO route: the SCF mesh must lie inside the GW q list, or the final lmf meets a k
## that step a' never built chi~ on, and Sigma gets read in a basis it was not written
## in.  Measured on GaAs 2026-09-25: nkabc=4^3 against n1n2n3=2^3 makes the SCF hit
## q=(0,0,0.5), which is not in the GW list; with both 2^3 there is no miss.  The Fortran
## side cannot check this (the SCF k list is not built in the GW driver), so check here,
## before anything runs.
if "--mlo" in options:
    def _mesh(sec, key):
        try:
            import tomllib
            with open(f"ctrlg.{target}.toml", "rb") as fh:
                return tomllib.load(fh).get(sec, {}).get(key)
        except Exception:
            return None
    _nk, _n123 = _mesh("bz", "nkabc"), _mesh("gw", "n1n2n3")
    _mlonk = _mesh("mlo", "mlo_nkabc")
    if _nk and _n123 and list(_nk) != list(_n123):
        raise SystemExit(
            f"gwsc --mlo: nkabc {_nk} != n1n2n3 {_n123}.\n"
            "  The MLO route needs the SCF mesh inside the GW q list: step a' builds chi~\n"
            "  on the GW q only, so any other SCF k would read Sigma^MLO in a rebuilt\n"
            "  basis.  Set nkabc = n1n2n3 (and mlo_nkabc = n1n2n3).")
    if _mlonk and _n123 and list(_mlonk) != list(_n123):
        raise SystemExit(f"gwsc --mlo: mlo_nkabc {_mlonk} != n1n2n3 {_n123}. Set them equal.")
    print(f" gwsc: MLO k-mesh check OK. nkabc = n1n2n3 = mlo_nkabc = {_n123}")


try:
    tmp=[int(s.strip('QPU.').strip('run')) for s in os.listdir() if 'QPU.' in s]
    Iter0=max(tmp) if len(tmp)!=0 else 0
except:
    Iter0=0
if(nloop==0):
    nloop=1
    print('WARN: We replace ITERADD=0 with ITERADD=1 because of backward compatibility.')

initxt="### START gwsc: ITERADD= %d, MPI size=  %d, %d TARGET= %s"%(nloop,ncore,ncore2,target)
print(initxt,flush=True)
ensure_dir('SEBK')
ensure_dir('STDOUT')
sigm_name='sigm.%s'%target
rst_name ='rst.%s'%target

#  sigm_name is a softlink. sigm contains static self-energy - Vxc
sigm = Path("sigm")
sigm_name = Path(sigm_name)
if sigm_name.exists() and not sigm_name.is_symlink():
    shutil.move(str(sigm_name), sigm)
if not sigm_name.is_symlink():
    sigm_name.unlink(missing_ok=True)
    sigm_name.symlink_to(sigm)

flist=['ctrlg.%s.toml'%target,rst_name,sigm_name,'save.%s'%target,'log.%s'%target,'QPU','QPD','lsxC','lsx','lsc','ECORE',
       'lgw','lqpe','llmfgw01','lmlo_sigr',   # 2026-09-28: the logs of each iteration, so that a gwsc N run can be checked afterwards
       'efermi.lmf','QMLO_SigRs','QMLO_z']    # 2026-09-28: with rst and sigm, what the bands of each iteration are drawn from
                                              # afterwards (the MLO band needs QMLO_SigRs in its chi~ QMLO_z; 9^3 LiTi2O4: 600 MB
                                              # per iteration).  HamRsMLO is not copied: --mlofreeze keeps one for the whole chain.

#initial band structre
print('===== Ititial band structure ====== ',flush=True)
if sigm_name.is_file():
    print("--> We use existing sigm file",flush=True)
    run_lmf(cluster, target,
            MPIParams(command=EXEC_DIR/"lmf", args=[target, *options], **mpi_params_lmf),
            bmix_reduction=True, stdout="llmf_start")
else:
    print("--> No sigm. LDA caculation for eigenfunctions ",flush=True)
    run_cmd(cluster, MPIParams(command=EXEC_DIR/"lmfa",
                               args=[target, *options], **mpi_params_single), stdout="llmfa")
    run_lmf(cluster, target,
            MPIParams(command=EXEC_DIR/"lmf", args=[target, *options], **mpi_params_lmf),
            bmix_reduction=True, stdout="llmf_lda")
    shutil.copy(rst_name,rst_name+'.lda')
    rundir='LDA'
    ensure_dir(rundir)
    patterns = [*flist, 'atmpnu*']; copy_files(*patterns, dest_dir=rundir)
    remove_files(f'__mixm*{target}*')

## Structure-only GW setup, hoisted out of the iteration loop.
##   lmf --jobgw=0 calls m_hamindex0_init() and exits (the jobgw==0 branch of main_lmf.f90) -> HAMindex0,
##   which depends on the structure and the basis, not on the density or sigm.
##   qg4gw --job=1 turns that plus the q mesh and the cutoffs into QGpsi/QGcou.
## Nothing in the loop deletes them, so once is enough.
## (NB `gwsc 1` x N is NOT identical to `gwsc N` regardless: each invocation re-runs
##  the "initial band structure" lmf when a sigm is already present.  That is gwsc's
##  normal behaviour, not an artefact of this hoisting.)
run_cmd(cluster, MPIParams(command=EXEC_DIR/"lmf", args=[target, "--jobgw=0", *options], **mpi_params_lmf), stdout="llmfgw00")
run_cmd(cluster, MPIParams(command=EXEC_DIR/"qg4gw", args=[target, "--job=1", *options], **mpi_params_single), stdout="lqg4gw")

## MLO route.  Files of MLO-QSGW: QMLO_* are kept (results, and what a chain needs to go on);
## __QMLO_* are rebuilt within one iteration.  At the head of every iteration wipe ONLY
## the work files that iteration rebuilds:
##   __HamiltonianGW*  : written by lmf --jobgw=1 each iteration; a truncated one from
##                       an aborted run once made `mlo` read past EOF.
##   __cmlo.*          : written by step a' each iteration.
##   __QMLO_zNew       : the chi~ slot step a' fills each iteration; a leftover from an
##                       aborted run would be promoted as if it matched QMLO_SigRs.
##   __QMLO_Sig        : Sigma^MLO(q), written by hqpe_sc and read by mlo in one iteration.
##                       A stale one must not reach `mlo --mlo` at the start of a chain.
##                       (The x_0 of the Sigma^MLO mixing is the Bloch sum of QMLO_SigRs.)
## Do NOT touch QMLO_SigRs / QMLO_z / HamRsMLO.  QMLO_z is the chi~ the existing QMLO_SigRs
## was written in; losing it means Sigma gets read back in the wrong basis.  QMLO_SigRs from
## the previous iteration is what makes lmf --jobgw=1 use the MLO route at all.
## Called before steps 0c/0d and again at the head of EVERY iteration (idempotent), so that
## a `gwsc N` treats each of its iterations like a fresh `gwsc 1`.
def mlo_iteration_start():
    remove_files('__cmlo.data', '__cmlo.info', '__HamiltonianGW', '__HamiltonianGW.info',
                 '__QMLO_zNew', '__QMLO_Sig')

if "--mlo" in options:
    mlo_iteration_start()

## MLO route (Samples/kBT/sigma_mlo_design.md 4.1): steps 0c/0d, ONCE per chain.
##   lmf --writeham --mlo -> HamiltonianPMTInfo, __HamiltonianPMT(.info)
##   mlo --mlo            -> HamRsMLO, whose trailing records carry the MLO index
##                           (ix, mlomethod, nskip; also the chain-start eferm, ecbot,
##                           which step a' no longer uses for its window).
## The INDEX (which MTO channels, ndimMTO) must stay the same for the whole chain:
## QMLO_SigRs is a matrix over those channels.  chi~ itself is rebuilt every iteration by
## step a' from that iteration's H.  Rebuilding HamRsMLO on every call would redefine the
## index, so skip it when HamRsMLO is already there; delete HamRsMLO by hand to start a
## new model.  `mlo --mlofreeze` (step 4) reads the lattice, k mesh and pair list from
## HamiltonianPMTInfo and the MLO index from HamRsMLO; the __HamiltonianPMT files are not
## needed after the index is made, so they may be deleted between gwsc calls.
## No --mkprocar here (2026-09-28 00:00): it only wrote PROCAR.UP.<rank> files that nothing read (job_mlo keeps it).
if "--mlo" in options:
    pmtfiles = ['HamiltonianPMTInfo']
    if Path('HamRsMLO').is_file():
        print('MLO: HamRsMLO exists -> keep the MLO index (skip mlo --mlo).', flush=True)
        if not all(Path(f).is_file() for f in pmtfiles):
            print('MLO: PMT Hamiltonian files missing -> lmf --writeham again.', flush=True)
            run_cmd(cluster, MPIParams(command=EXEC_DIR/"lmf", args=[target, "--writeham", "--noinv", *options], **mpi_params_lmf), stdout="llmf_writeham")
    else:
        run_cmd(cluster, MPIParams(command=EXEC_DIR/"lmf", args=[target, "--writeham", "--noinv", *options], **mpi_params_lmf), stdout="llmf_writeham")
        run_cmd(cluster, MPIParams(command=EXEC_DIR/"mlo", args=[target, *options], **mpi_params_lmf), stdout="lmlo_index")

# main iteration ###################################
if(Iter0!=0): print(f'We found QPU.{Iter0} -->start to generate QPU.{Iter0+1}...')
for i in range(1,nloop+1): #nloop is the additional number of iteration
    niter=i+Iter0
    prec_i = final_prec if (final_prec is not None and i > nloop - nfinal) else base_prec
    exec_type = ('_mp' if prec_i != 'fp64' else '') + ('_gpu' if args.gpu else '')   # GW programs of this precision
    options = [o for o in options if o not in ('--use_fp32', '--sigma_tf32')] + \
              {'fp32': ['--use_fp32'], 'tf32': ['--use_fp32', '--sigma_tf32']}.get(prec_i, [])
    print(f'===== QSGW iteration start iter {niter} === (GW precision {prec_i})',flush=True)
    if "--mlo" in options:
        mlo_iteration_start()   #x_0 of this iteration's Sigma^MLO mixing; a no-op on the first pass
    #gw initialize (only --jobgw=1; the structure-only part is above the loop)
    run_cmd(cluster, MPIParams(command=EXEC_DIR/"lmf", args=[target, "--jobgw=1", *options], **mpi_params_lmf), stdout="llmfgw01")

    ## (step a' -- __cmlo.data -- is done inside lmf --jobgw=1 above, see sugw.f90)

    #main stage of gw #
    run_cmd(cluster, MPIParams(command=EXEC_DIR/"heftet", args=[target, "--job=1", *options], **mpi_params_single), stdout="leftet")

    ## Core part of the self-energy (exchange only) ##
    run_cmd(cluster, MPIParams(command=EXEC_DIR/"hbasfp0", args=[target, "--job=3", *options], **mpi_params_single), stdout="lbasC")
    run_cmd(cluster, MPIParams(command=EXEC_DIR/f"hvccfp0{exec_type}", args=[target, "--job=3", *options], **mpi_params_gw), stdout="lvccC")
    run_cmd(cluster, MPIParams(command=EXEC_DIR/f"hsfp0_sc{exec_type}", args=[target, "--job=3", *options], **mpi_params_gw), stdout="lsxC")
    move_files('stdout*', dest_dir='STDOUT')

    ## Valence basis + Coulomb matrix ##
    run_cmd(cluster, MPIParams(command=EXEC_DIR/"hbasfp0", args=[target, "--job=0", *options], **mpi_params_single), stdout="lbas")

    ## With the GPU, the CPU cores are idle while hvccfp0 and hgw run: a helper run of the same hgw on them
    ## (--tetwt_write, no GPU) writes the tetrahedron weights of every q to __TETWT.<iq>.<isp>, and hgw reads
    ## them instead of computing them (bit-identical; a missing or non-matching file is computed in hgw).
    tetwt_helper = None
    if args.gpu and not args.no_tetwt_helper:
        for f in Path().glob('__TETWT.*'):
            f.unlink()
        tetwt_helper = start_cmd(cluster, MPIParams(command=EXEC_DIR/f"hgw{exec_type}",
                                                    args=[target, "--jobgw=1", "--tetwt_write", *options],
                                                    **mpi_params_lmf), stdout="lgw_tetwt", cpu_only=True)
    run_cmd(cluster, MPIParams(command=EXEC_DIR/f"hvccfp0{exec_type}", args=[target, "--job=0", *options], **mpi_params_gw), stdout="lvcc")

    ## Valence Sx + Screened W + Correlation Sc (combined, in-process) ##
    run_cmd(cluster, MPIParams(command=EXEC_DIR/f"hgw{exec_type}", args=[target, "--jobgw=1", *options], **mpi_params_gw), stdout="lgw")
    if tetwt_helper is not None:
        rc = finish_cmd(tetwt_helper)
        if rc != 0:
            print(f'gwsc: the tetrahedron-weight helper ended with rc={rc} (see lgw_tetwt); hgw computed what was missing.')
        for f in Path().glob('__TETWT.*'):
            f.unlink()
    move_files('stdout*', dest_dir='STDOUT')

    ## Make Vxc^QSGW (sigm file).  With --mlo it also writes __QMLO_Sig = Sigma in the MLO basis.
    run_cmd(cluster, MPIParams(command=EXEC_DIR/"hqpe_sc", args=[target, *options], **mpi_params_single), stdout="lqpe")

    ## Sigma^MLO(q) -> Sigma^MLO(R) (QMLO_SigRs), on the same pair list as HamRsMLO.
    ## --mlofreeze keeps the HamRsMLO made before the loop, i.e. the MLO INDEX
    ## (ix, ndimMTO, the channel list) is fixed for the whole chain.  It has to be:
    ## QMLO_SigRs is a matrix over those channels, so ndimMTO may not change under it.
    if "--mlo" in options:
        run_cmd(cluster, MPIParams(command=EXEC_DIR/"mlo", args=[target, "--mlofreeze", *options], **mpi_params_lmf), stdout="lmlo_sigr")

    ## PROMOTE the chi~ slot.  Sigma^MLO_{ab} = <chi~_a|Sigma|chi~_b> is a matrix in a
    ## basis, so getsenex may only put it back into the PMT basis through the SAME chi~.
    ## sugw's step a' has just built chi~ for the H of this iteration into __QMLO_zNew and
    ## expressed the Sigma above in it, so __QMLO_zNew becomes the basis to read that
    ## QMLO_SigRs back in.  Renaming here, right after QMLO_SigRs is written, keeps the two
    ## in step: before this line QMLO_z belonged to the previous QMLO_SigRs, after it to
    ## the new one.  chi~ therefore FOLLOWS the Hamiltonian (its energy window does not
    ## go stale) while Sigma is never re-read in a basis it was not written in.
    ## `mlo` has normally done this already (m_HamPMT PromoteChiSlot); then it is a no-op.
    if "--mlo" in options:
        znew = Path('__QMLO_zNew')
        if znew.is_file():
            znew.replace('QMLO_z')
            print(' gwsc: promoted __QMLO_zNew -> QMLO_z (chi~ of the new QMLO_SigRs)')

    ## lmf with Vxc^QSGW
    run_lmf(cluster, target, MPIParams(command=EXEC_DIR/"lmf", args=[target, *options], **mpi_params_lmf), bmix_reduction=True, stdout="llmf")

    # final part of iteration loop. Manupulate files
    move_files('SEX*', 'SEC*', 'XC*', dest_dir='SEBK')
    for name in ['QPU', 'QPD', 'llmf']:
        f = Path(name)
        if f.is_file():
            shutil.copy(f, f.with_name(f"{name}.{niter}run"))

    rundir='QSGW.%drun'%niter
    ensure_dir(rundir)
    patterns = [*flist, 'atmpnu*']; copy_files(*patterns, dest_dir=rundir)

    print(f'===== QSGW iteration end   iter {niter} ===',flush=True)
print('OK! ==== All calclation finished for  gwsc ====')
