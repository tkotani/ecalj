{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "InstallAll-ifx (notest)",
      "type": "shell",
      "command": "python ./InstallAll.py --fc=ifx --notest"
    },
    {
      "label": "InstallAll-ifx",
      "type": "shell",
      "command": "python ./InstallAll.py --fc=ifx"
    },
    {
      "label": "InstallAll-nvfortran CPU & GPU versions (notest)",
      "type": "shell",
      "command": "python ./InstallAll.py --fc=nvfortran --gpu --notest"
    },
    {
      "label": "InstallAll-nvfortran CPU & GPU versions",
      "type": "shell",
      "command": "python ./InstallAll.py --fc=nvfortran --gpu"
    },
    {
      "label": "build-ifx",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "FC=ifx cmake -S ./SRC/exec -B ./SRC/exec/build && cmake --build ./SRC/exec/build -j"
      ]
    },
    {
      "label": "build-nvfortran CPU & GPU versions",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "FC=nvfortran cmake -S ./SRC/exec -B ./SRC/exec/build -DBUILD_MP=ON -DBUILD_GPU=ON -DBUILD_MP_GPU=ON && cmake --build ./SRC/exec/build -j"
      ]
    },
    {
      "label": "clean\n",
      "type": "shell",
      "command": "cmake --build ./SRC/exec/build --target clean"
    }
  ]
}
