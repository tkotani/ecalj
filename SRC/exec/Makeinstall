#! /bin/bash
# Install ecalj binaries + Python/shell drivers to ${HOME}/bin.
# Run from SRC/exec/ after `make` (or `make <target>`) in build/.
#
# Why we sync build/ -> SRC/exec/ first:
#   cmake's `deliver` target runs only with `make` (the ALL target).
#   `make mlo` etc. updates build/{libecaljF.so,mlo,...} but leaves
#   SRC/exec/ stale. Without this sync, $ORIGIN-rpath'd binaries
#   (lmf, mlo) loaded from SRC/exec/ would pick up old libecaljF.so.
BINDIR=${HOME}/bin
mkdir -p "${BINDIR}"

# 1) Sync freshly built artifacts (executables + libecaljF.so) from build/ to SRC/exec/.
if [ -d build ]; then
  artifacts=$(find build -mindepth 1 -maxdepth 1 -executable -type f)
  if [ -n "${artifacts}" ]; then
    cp -f ${artifacts} .
  fi
fi

# 2) Build the deduped install list:
#    a) executables in SRC/exec/  (incl. libecaljF.so)
#    b) shell drivers without extension that are listed by mklloc.txt / run* glob
#    c) all *.py (executables + importable modules: gwinput_prepare.py, toml_comments.py, ...)
#    Strip ./ prefix so dedup works across find vs glob.
files=$( {
  find . -mindepth 1 -maxdepth 1 -executable -type f -printf '%f\n'
  ls mklloc.txt run* *.py 2>/dev/null
} | awk '!seen[$0]++')

# 3) Install each file individually, skipping cases where target == source
#    (e.g. /home/takao/bin/job_mlo_soc is a symlink to SRC/exec/job_mlo_soc).
for f in ${files}; do
  src="$(realpath "${f}" 2>/dev/null)"
  dst="$(realpath -m "${BINDIR}/${f}" 2>/dev/null)"
  [ "${src}" = "${dst}" ] && continue
  cp -f "${f}" "${BINDIR}/"
done
