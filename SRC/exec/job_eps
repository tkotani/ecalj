#!/usr/bin/env python3
import argparse
import contextlib
import subprocess
from pathlib import Path
from pylib.run_cmd import run_cmd, MPIParams

EXEC_DIR = Path(__file__).parent
RY = 13.605693  # Rydberg in eV

def _glt_header(title, output):
    return (f'set terminal pdf\n'
            f'set output "{output}"\n'
            f'set title "{title}"\n'
            f'set xlabel "Energy (eV)"\n'
            f'set ylabel "Re(eps): red, Im(eps): green"\n'
            f'set xrange [0:20.0]\n'
            f'set grid\n'
            f'set zeroaxis\n')

def _run_gnuplot(glt, nognuplot):
    if not nognuplot:
        try:
            subprocess.run(["gnuplot", glt], check=True)
        except FileNotFoundError:
            print("Skip gnuplot")

def _write_glt(glt, title, output, plot_lines, nognuplot):
    Path(glt).write_text(_glt_header(title, output) + '\n'.join(plot_lines) + '\n')
    _run_gnuplot(glt, nognuplot)

def plot_eps(target, lcf, nognuplot):
    lcf_str = "with_lcf" if lcf else "without_lcf"
    base_pat = "EPS????.dat" if lcf else "EPS????.nlfc.dat"
    plots = [
        f'plot "{p.name}" u ($4*{RY}):5 w l lc rgb "red", '
        f'"{p.name}" u ($4*{RY}):6 w l lc rgb "green"'
        for p in sorted(Path('.').glob(base_pat))
    ]
    _write_glt(f'eps_{lcf_str}_{target}.glt', 'EPS', f'eps_{lcf_str}_{target}.pdf', plots, nognuplot)

def plot_eps_decompose(target, lcf, nognuplot):
    base_pat = "EPS????.dat" if lcf else "EPS????.nlfc.dat"
    for suffix, title in [('interbandonly', 'InterBand'), ('intrabandonly', 'IntraBand')]:
        files = sorted(Path('.').glob(f'{base_pat}.{suffix}'))
        if not files:
            continue
        plots = [
            f'plot "{p.name}" u ($4*{RY}):5 w l lc rgb "red" title "Re", '
            f'"{p.name}" u ($4*{RY}):6 w l lc rgb "green" title "Im"'
            for p in files
        ]
        _write_glt(f'eps_{suffix}_{target}.glt', f'EPS {title}',
                   f'eps_{suffix}_{target}.pdf', plots, nognuplot)

    # sum: eps1_total = eps1_inter + eps1_intra - 1, eps2_total = eps2_inter + eps2_intra
    inter_files = sorted(Path('.').glob(f'{base_pat}.interbandonly'))
    intra_files = sorted(Path('.').glob(f'{base_pat}.intrabandonly'))
    if inter_files and intra_files:
        plots = [
            f'plot "< paste {a} {b}" u ($4*{RY}):($5+$11-1) w l lc rgb "red" title "Re", '
            f'"< paste {a} {b}" u ($4*{RY}):($6+$12) w l lc rgb "green" title "Im"'
            for a, b in zip(inter_files, intra_files)
        ]
        _write_glt(f'eps_total_{target}.glt', 'EPS total (inter+intra)',
                   f'eps_total_{target}.pdf', plots, nognuplot)

def cal_eps(args, extra_args):
    cluster = args.cluster
    target = args.extension
    mpi_size = args.np
    options = extra_args

    print(f"### start eps with/without lcf: mpi size= {mpi_size}, target= {target}")
    run_cmd(cluster, MPIParams(nprocs=1, command=EXEC_DIR/"lmf", args=[target, "--jobgw=0", '--novxc', *options]), stdout="llmfgw00")
    run_cmd(cluster, MPIParams(nprocs=1, command=EXEC_DIR/"qg4gw", args=["--job=2", *options]), stdout="lqg4gw02")
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--jobgw=1", "--skipbstruxinit", *options]), stdout="llmfgw01")
    run_cmd(cluster, MPIParams(nprocs=1, command=EXEC_DIR/"heftet", args=["--job=1", *options]), stdout="leftet")

    if args.lcf:
        run_cmd(cluster, MPIParams(nprocs=1, command=EXEC_DIR/"hbasfp0", args=["--job=0", *options]), stdout="lbas")
    else:
        run_cmd(cluster, MPIParams(nprocs=1, command=EXEC_DIR/"hbasfp0", args=["--job=4", *options]), stdout="lbas")
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"hvccfp0", args=["--job=202", *options]), stdout="lvcc")

    job = "--job=203" if args.lcf else "--job=202"
    if args.decompose:
        run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"hx0fp0",
                                   args=[job, "--interbandonly", *options]), stdout="lx0_interband")
        run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"hx0fp0",
                                   args=[job, "--intrabandonly", *options]), stdout="lx0_intraband")
    else:
        run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"hx0fp0",
                                   args=[job, *options]), stdout="lx0")

    print(f"OK! ==== All calculation finished for eps ====")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(prog='eps', description='dielectric function calculation')
    parser.add_argument("extension",    help='extension of ctrl')
    parser.add_argument("-c", "--cluster", help="cluster name", default="default", type=str)
    parser.add_argument("-np",          help='number of mpi cores in lmf', default=8, type=int)
    parser.add_argument('--gpu',        help='USE GPU version for hsfp0 and hgw', action='store_true')
    parser.add_argument('--lcf',        help='local field correction', action='store_true')
    parser.add_argument("--nognuplot",  help="stop without drawing", action="store_true", default=False)
    parser.add_argument("-d", "--dir",  help="execution directory (default: current directory)", default=".", type=str)
    parser.add_argument('--decompose',  help='run both --interbandonly and --intrabandonly',
                        action='store_true')

    args, extra_args = parser.parse_known_args()
    with contextlib.chdir(args.dir):
        cal_eps(args, extra_args)
        if args.decompose:
            plot_eps_decompose(args.extension, args.lcf, args.nognuplot)
        else:
            plot_eps(args.extension, args.lcf, args.nognuplot)
