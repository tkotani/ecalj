#!/usr/bin/env python3
"""job_mloW: DFT + MLO Wannier function + screened Coulomb W calculation.

Runs: lmfa → lmf → lmf(GW prep) → qg4gw → lmf(--jobgw=1 --mlo) →
      heftet → hbasfp0 → mlo → hvccfp0 → hwmatK_MPI(v) → hx0fp0 → hwmatK_MPI(W-v)
      [--crpa: → hwmatK_MPI(pkm4crpa) → hx0fp0(10011) → hwmatK_MPI(W-v cRPA)]

Requires bnd001.spin1 (run job_band first) and ctrlg.<target>.toml.
"""
import argparse
import contextlib
import sys
from pathlib import Path
from pylib.run_cmd import run_cmd, MPIParams

EXEC_DIR = Path(__file__).parent


def cal_mloW(args, extra_args):
    cluster  = args.cluster
    target   = args.extension
    mpi_size = args.np
    options  = extra_args

    if not Path('bnd001.spin1').exists():
        sys.exit('job_mloW: bnd001.spin1 not found — run job_band first')

    # The GW side reads ctrlg.<target>.toml only (the old GWinput.toml gate
    # here only ever checked for a file nothing consumed).
    if not Path(f'ctrlg.{target}.toml').is_file():
        sys.exit(f'job_mloW: ctrlg.{target}.toml not found')

    # If sigm exists alongside sigm.<target>, symlink sigm.<target> → sigm (GW mode).
    sigm     = Path('sigm')
    sigm_mat = Path(f'sigm.{target}')
    if sigm.exists():
        if sigm_mat.exists():
            sigm_mat.rename(f'sigm.{target}.bakup')
            sigm_mat.symlink_to('sigm')
            print(f'--- sigm is used; sigm.{target} symlinked to it ---')
    else:
        print(f'--- sigm not found => LDA ---')

    # --- DFT self-consistency ---
    run_cmd(cluster, MPIParams(nprocs=1,        command=EXEC_DIR/'lmfa', args=[target, *options]), stdout='llmfa')
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'lmf',  args=[target, *options]), stdout='llmf_start')

    # --- GW prerequisites ---
    run_cmd(cluster, MPIParams(nprocs=1,        command=EXEC_DIR/'lmf',    args=[target, '--jobgw=0', *options]),           stdout='llmfgw00')
    run_cmd(cluster, MPIParams(nprocs=1,        command=EXEC_DIR/'qg4gw',  args=[target, '--job=1',   *options]),           stdout='lqg4gw')
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'lmf',    args=[target, '--jobgw=1', '--mlo', *options]),  stdout='llmfgw01')
    run_cmd(cluster, MPIParams(nprocs=1,        command=EXEC_DIR/'heftet', args=[target, '--job=1',   *options]),           stdout='leftet')
    run_cmd(cluster, MPIParams(nprocs=1,        command=EXEC_DIR/'hbasfp0',args=[target, '--job=0',   *options]),           stdout='lbas')

    # --- MLO + screened Coulomb ---
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'mlo',        args=[target, '--mlo', *options]), stdout='lmlo')
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'hvccfp0',    args=[target, *options]), stdin_str='0',   stdout='lvcc')
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'hwmatK_MPI', args=[target, '--mlo', *options]), stdin_str='1',   stdout='lwmatK1')
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'hx0fp0',     args=[target, *options]), stdin_str='111', stdout='lx0_111')
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'hwmatK_MPI', args=[target, '--mlo', *options]), stdin_str='2',   stdout='lwmatK2')

    # --- cRPA (--crpa): W with the screening inside the MLO model removed (2026-10-01) ---
    # pkm4crpa: p_kn = [C (C^+C)^-1 C^+]_nn, the weight of band n in the MLO subspace (m_mlo_wfs);
    # hx0fp0 10011 weights each transition of chi0 by 1 - p_kn p_k+q,n'; hwmatK 100 writes Screening_W-v_crpa.UP/DN.
    if args.crpa:
        run_cmd(cluster, MPIParams(nprocs=1,        command=EXEC_DIR/'hwmatK_MPI', args=[target, '--mlo', *options]), stdin_str='10011', stdout='lpkm4crpa')
        run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'hx0fp0',     args=[target, *options]), stdin_str='10011', stdout='lx0_10011')
        run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/'hwmatK_MPI', args=[target, '--mlo', *options]), stdin_str='100',   stdout='lwmatK2crpa')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(
        prog='job_mloW',
        description='DFT + MLO Wannier + screened Coulomb W. Requires bnd001.spin1.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('extension',      help='ctrl file extension (material name)')
    parser.add_argument('-np',            help='MPI cores', default=8, type=int)
    parser.add_argument('-c', '--cluster',help='cluster name', default='default')
    parser.add_argument('-d', '--dir',    help='working directory (default: current)', default='.')
    parser.add_argument('--crpa',         help='also the cRPA W (screening inside the MLO model removed): Screening_W-v_crpa.UP/DN', action='store_true')
    parser.add_argument('--mlo_raw', action='store_true',
                        help='the MLOs as they are (not orthonormal) for v, W and the kernels; by default their Loewdin orthonormalized '
                             'combinations (projected Wannier functions of the MLO subspace, --mlo_lowdin), which keep the symmetry and '
                             'the orbital labels and make U, J and the magnons independent of the window (2026-10-02 11:36)')

    args, extra_args = parser.parse_known_args()
    if not args.mlo_raw and '--mlo_lowdin' not in extra_args:
        extra_args.append('--mlo_lowdin')
    with contextlib.chdir(args.dir):
        cal_mloW(args, extra_args)
