#!/usr/bin/env python3
"""
{TOOL} -- thin Python wrapper for the Fortran binary {TOOL}_main.

Default mode: TOML-only. Reads ctrlG.<sname>.toml + PB.toml as-is.

  {TOOL} -np 4 si           (recommended)
  {TOOL} si                 (default -np = 1)
  {TOOL} --legacy -np 4 si  (run Legacy2toml.py first to convert from
                             ctrl.<sname> + GWinput, then proceed)

If invoked under mpirun (e.g. `mpirun -np 4 {TOOL} si`), exits with a
clear error -- use `mpirun -np 4 {TOOL}_main si` instead, or use the
wrapper's own -np option.
"""
import os, sys, subprocess

# ----- detect mpirun-launched wrapper -----
# If we are already running under mpirun (rank env set), skip the
# wrapper's internal mpirun and just exec the Fortran binary directly.
# Pass any extra args through. --legacy is ignored under mpirun (the
# user must run Legacy2toml.py themselves before mpirun -- we can't
# safely fork a converter from inside one of N ranks).
_MPI_RANK_ENVS = ('OMPI_COMM_WORLD_RANK', 'PMI_RANK', 'SLURM_PROCID')
_under_mpirun = any(v in os.environ for v in _MPI_RANK_ENVS)
if _under_mpirun:
    _name = os.path.basename(sys.argv[0])
    _here = os.path.dirname(os.path.realpath(__file__))
    _binary = os.path.join(_here, _name + '_main')
    # Drop wrapper-specific flags (-np / --legacy); pass everything else.
    _passthru = []
    _i = 1
    while _i < len(sys.argv):
        _a = sys.argv[_i]
        if _a == '-np':       _i += 2; continue
        if _a.startswith('-np='): _i += 1; continue
        if _a == '--legacy':  _i += 1; continue
        _passthru.append(_a); _i += 1
    os.execvp(_binary, [_binary, *_passthru])

# ----- arg parse -----
argv = sys.argv[1:]
np_n = 1
legacy = False
remaining = []
i = 0
while i < len(argv):
    a = argv[i]
    if a == '-np':
        np_n = int(argv[i+1]); i += 2; continue
    if a.startswith('-np='):
        np_n = int(a.split('=',1)[1]); i += 1; continue
    if a == '--legacy':
        legacy = True; i += 1; continue
    remaining.append(a); i += 1

# ----- find sname (first non-flag arg) -----
sname = next((a for a in remaining if not a.startswith('-')), None)

# ----- --legacy: pre-convert legacy ctrl + GWinput -> ctrlG/PB -----
_TOOL = os.path.basename(sys.argv[0])
if legacy:
    if sname is None:
        sys.exit('--legacy requires a positional sname (e.g. "si")')
    here = os.path.dirname(os.path.realpath(__file__))
    print('=== ' + _TOOL + ': --legacy mode -> Legacy2toml.py ' + sname + ' ===', flush=True)
    rc = subprocess.run([os.path.join(here, 'Legacy2toml.py'), sname]).returncode
    if rc != 0:
        sys.exit('Legacy2toml.py failed (rc=' + str(rc) + ')')
else:
    if sname is not None:
        print('=== ' + _TOOL + ': TOML mode (reading ctrlG.' + sname + '.toml + PB.toml as-is) ===', flush=True)

# ----- launch {TOOL}_main under mpirun -----
here = os.path.dirname(os.path.realpath(__file__))
binary = os.path.join(here, _TOOL + '_main')
cmd = ['mpirun', '-np', str(np_n), binary, *remaining]
sys.stdout.flush()
sys.exit(subprocess.run(cmd).returncode)
