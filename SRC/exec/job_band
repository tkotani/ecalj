#!/usr/bin/env python3
import argparse
import subprocess
from pathlib import Path
from run_cmd import run_cmd, MPIParams
from utils import merge_files, remove_files

EXEC_DIR = Path(__file__).resolve().parent

def get_number_of_ions(fin):
    nions = 0
    in_ion_block = False
    for iline in fin:
        if 'ion' in iline:
            in_ion_block = True
            continue
        if in_ion_block:
            if 'tot' in iline:
                break
            nions += 1
    return nions

def write_bandweight(fin, fouts, nions, emin, emax):
    ionline = False
    y = 0
    x = "0"
    outs = {i: [] for i in range(1, nions + 1)} 
    for iline in fin.readlines():
        if not iline.strip():
            continue
        if 'k-point' in iline:
            x = (iline.split('x =')[1]).split('\n')[0]
            ionline = False
        if 'band' in iline:
            ionline = False
            y = iline.split('energy')[1].split('#')[0]
        if 'ion' in iline:
            ionline = True
        if not emin < float(y) < emax:
            continue
        if not ionline:
            continue
        ilines = iline.split()
        try:
            iion = int(ilines[0])
            if 1 <= iion <= nions:
                #print s to f orbitals
                outs[iion].append((x, y, ' '.join(ilines[1:17]), '\n'))
        except ValueError:
            continue
    for iion in range(1, nions + 1):
        for i in outs[iion]:
            fouts[iion].write(' '.join(map(str, i)))

def process_files(input_filename, ispin, emin, emax):
    path = Path(input_filename)
    if not path.exists():
        print(f"skip: {input_filename} not found")
        return
    with path.open('r') as fin:
        nions = get_number_of_ions(fin)
        print("number of ions", nions)
        fin.seek(0)
        prefix = "bandweight_atom" if ispin == 1 else "bandweight_atom"
        extension = "spin1"        if ispin == 1 else "spin2"
        fouts = {i: open(f"{prefix}{i}.{extension}", "w") for i in range(1, nions + 1)}
        for f in fouts.values():
            f.write("#    k-index        energy      s       py      pz      px      dxy     dyz      dz2    dxz     dx2-y2  f-3     f-2     f-1     f0      f1      f2      f3\n")
        try:
            write_bandweight(fin, fouts, nions, emin, emax)
        finally:
            for fout in fouts.values():
                fout.close()

def ensure_syml(target):
    nfpgw = Path(__file__).resolve().parent
    filename = f"syml.{target}"
    filepath = Path(filename)
    if not filepath.exists():
        print(f"{filename} is generated by getsyml")
        subprocess.run(["python", str(nfpgw / "getsyml"), target])



def cal_band(args, extra_args):
    target = args.extension
    mpi_size = args.np
    cluster = args.cluster
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--quit=band", *extra_args]), stdout="llmf_ef")
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--band", *extra_args]), stdout="llmf_band")

    if not args.NoGnuplot:
        for fname in ['bandplot.isp1.glt', 'bandplot.isp2.glt']:
            if not Path(fname).exists():
                subprocess.run(['gnuplot', '-persist', fname])
    print("If you like, edit and run 'job_band, or gnuplot -persist bandplot.isp1.glt (and isp2)'")

def cal_fatband(args, extra_args):
    target = args.extension
    mpi_size = args.np
    cluster = args.cluster
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--mkprocar", '--band', *extra_args]), stdout="lbandW")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog='band',
        description=(
            'Example:\n'
            "An example of usage: job_band si -np 4 [options for lmf]\n"
            " For example, [options for lmf] is ' -vpwemax=4 -vgmax=15 -vxcfun=103'\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("extension",   help='Extension of the ctrl file') #extension is dummy. just to have similar interface with other scripts
    parser.add_argument("--cluster",   help="cluster name", default="default", type=str)
    parser.add_argument("-np",         help='Number of MPI cores for lmf', default=8, type=int)
    parser.add_argument("--fatband",   help='get fatband', action='store_true')
    parser.add_argument('--emin',      type=float, default=-40, help='cut off energy')
    parser.add_argument('--emax',      type=float, default= 20, help='cut off energy')
    parser.add_argument("--NoGnuplot", "--nognuplot", help="stop without drawing", action="store_true")

    args, extra_args = parser.parse_known_args()

    ensure_syml(args.extension)
    cal_band(args, extra_args)

    if args.fatband:
        remove_files("PROCAR.UP.*", "PROCAR.DN.*")
        cal_fatband(args, extra_args)
        merge_files(pattern="PROCAR.UP.*", output_file="PROCAR.UP", remove_sources=True)
        merge_files(pattern="PROCAR.DN.*", output_file="PROCAR.DN", remove_sources=True)
        process_files("PROCAR.UP", 1, args.emin, args.emax)
        process_files("PROCAR.DN", 2, args.emin, args.emax)
