#!/bin/bash
# Generate GWinput.toml.tmp -- a TOML template for GWinput.
# Steps: lmfa -> lmf --jobgw=0 -> gwinit
# Output: GWinput.toml.tmp (rename to GWinput.toml after editing)
set -e
nfpgw=$(dirname "$0")

if [ $# -lt 1 ]; then
    echo "usage: mkGWinput <target>     (e.g. mkGWinput si)"
    exit 1
fi

target=$1
mpirun -np 1 "$nfpgw/lmfa" "$target"  > llmfa
mpirun -np 1 "$nfpgw/lmf"  --jobgw=0  "$target" > llmfgw00
mpirun -np 1 "$nfpgw/gwinit"

echo
echo '-------------------------------------------------------------------'
echo '  Default n1n2n3 = 4 4 4 (BZ mesh for GW). Edit GWinput.toml.tmp by hand if needed.'
echo '  Then:    mv GWinput.toml.tmp GWinput.toml'
echo 'OK! GWinput.toml.tmp generated.'
