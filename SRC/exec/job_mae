#!/usr/bin/env python3
import argparse
import glob
import os
import re
import shutil
from run_arg import run_arg

def get_sigm_fbz(args, extra_args):
    nfpgw = os.path.dirname(os.path.abspath(__file__))
    TARGET = args.extension
    MPI_SIZE = args.np
    NO_MPI = 1
    run_arg('---', NO_MPI, nfpgw, '/lmf', 'llmf_wsig_fbz', TARGET, '--phispinsym --wsig_fbz', *extra_args)

def get_mae_gcft(args, extra_args):
    nfpgw = os.path.dirname(os.path.abspath(__file__))
    TARGET = args.extension
    MPI_SIZE = args.np
    NO_MPI = 1
    print(f"### START MAE calculation: MPI size= {MPI_SIZE}, TARGET= {TARGET}")

    if not args.skipSCF:
        run_arg('---', MPI_SIZE, nfpgw, '/lmf', 'llmf_phispinsym', TARGET, '--phispinsym', *extra_args)
    run_arg('---', MPI_SIZE, nfpgw, '/lmf', 'llmf_nosoi_ef', TARGET, '--phispinsym --quit=band', *extra_args)

    if os.path.isfile(f'sigm.{TARGET}'):
        get_sigm_fbz(args, extra_args)

    run_arg(
        '---', MPI_SIZE, nfpgw, '/lmf', 'llmf_so001', TARGET,
        '--nosym --use_sigm_fbz', '--skipbstruxinit', '--phispinsym', '-vso=1', '--quit=band', '-vsoa1=0 -vsoa2=0 -vsoa3=1',
        *extra_args
    )
    run_arg(
        '---', MPI_SIZE, nfpgw, '/lmf', 'llmf_so100', TARGET,
        '--nosym --use_sigm_fbz', '--skipbstruxinit', '--phispinsym', '-vso=1', '--quit=band', '-vsoa1=1 -vsoa2=0 -vsoa3=0',
        *extra_args
    )
    run_arg(
        '---', MPI_SIZE, nfpgw, '/lmf', 'llmf_so010', TARGET,
        '--nosym --use_sigm_fbz', '--skipbstruxinit', '--phispinsym', '-vso=1', '--quit=band', '-vsoa1=0 -vsoa2=1 -vsoa3=0',
        *extra_args
    )
    run_arg(
        '---', MPI_SIZE, nfpgw, '/lmf', 'llmf_so110', TARGET,
        '--nosym --use_sigm_fbz', '--skipbstruxinit', '--phispinsym', '-vso=1', '--quit=band', '-vsoa1=1 -vsoa2=1 -vsoa3=0',
        *extra_args
    )
    vals = []
    for suf in ["100", "010", "001", "110"]:
        with open(f"llmf_so{suf}") as f:
            for line in reversed(f.readlines()):
                m = re.search(r'sev\(eV\)=([-\d\.]+)', line)
                if m:
                    vals.append(float(m.group(1)))
                    break
    if len(vals) == 4:
        print(f"sev(eV) 100: {vals[0]}")
        print(f"sev(eV) 010: {vals[1]}")
        print(f"sev(eV) 001: {vals[2]}")
        print(f"sev(eV) 110: {vals[3]}")
        print(f"Difference (100 - 001): {(vals[0] - vals[2]) * 1000} meV")
        print(f"Difference (010 - 001): {(vals[1] - vals[2]) * 1000} meV")
        print(f"Difference (110 - 001): {(vals[3] - vals[2]) * 1000} meV")
    else:
        print("sev(eV) not found.")
    print("### MAE calculation finished.")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog='job_mae',
        description=(
            'Get magnetic anistoropy energy 110 - 001 direction\n'
            'Example:\n'
            '  job_mae fept -np 8\n'
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("extension", help='Extension of the ctrl file')
    parser.add_argument("-np",       help='Number of MPI cores for lmf', default=8, type=int)
    parser.add_argument("--skipSCF", help='SKIP SCF calculation', action='store_true')
    args, extra_args = parser.parse_known_args()
    get_mae_gcft(args, extra_args)
