############
set terminal pdf
set pm3d map
set pm3d map interpolate 1,1 # interpolation
set palette defined ( 0 '#000090',1 '#000fff',2 '#0090ff',3 '#0fffee',4 '#90ff70',5 '#ffee00',6 '#ff7000',7 '#ee0000',8 '#7f0000')

set logscale cb
set cbrange[0.01:100]
set yrange[-100:1000]

set xrange[0:1]
set cblabel "Im R^{-+}(1/eV)"
set ylabel "{/Symbol w} [meV]"
set xtics(\
'{/Symbol G}'   0.0000000000,\
'H'   1.0000000000 \
)
set output "magnon3d_100.pdf"
splot "TrRpm.syml001" u 4:($5*1000):(-$7) with pm3d ti ""

################################################
### ImK
set yrange[-1:3]
set xrange[0:1]
set cbrange[0.01:10]
set ylabel "{/Symbol w} [eV]"
set xtics(\
'{/Symbol G}'   0.0000000000,\
'H'   1.0000000000 \
)
set cblabel "-Im K^{-+}(1/eV)"
set output "stoner3d_100.pdf"
splot "TrKpm.syml001" u 4:($5):($7) with pm3d ti ""
