#!/usr/bin/env python3
import argparse
import contextlib
import subprocess
from pathlib import Path
from pylib.run_cmd import run_cmd, MPIParams
from pylib.utils import run_gnuplot
from pylib.utils import merge_files, remove_files

EXEC_DIR = Path(__file__).parent

def so_of_input(target, extra_args):
    """[ham] so of ctrlg.<target>.toml, or of --ctrlg:ham.so=<n> when given (None if unknown)."""
    for a in extra_args:
        if a.startswith('--ctrlg:ham.so='):
            return a.split('=', 1)[1].strip()
    try:
        import tomllib
        with open(f'ctrlg.{target}.toml', 'rb') as fi:
            return str(tomllib.load(fi).get('ham', {}).get('so', 0))
    except Exception:
        return None

def cal_mlo(args, extra_args):
    target = args.extension
    mpi_size = args.np
    cluster = args.cluster
    # so = 1 (L.S) is not a model of mlo: the Hamiltonian comes out NaN (2026-10-01, GaAs_so). SOC goes through
    # job_mlo_soc, which builds the model without SOC and adds the L.S matrix as a perturbation.
    if so_of_input(target, extra_args) == '1':
        raise SystemExit(f'job_mlo: ctrlg.{target}.toml has [ham] so = 1. Use job_mlo_soc {target} (SOC added to the MLO model), '
                         'or give --ctrlg:ham.so=0 for the model without SOC.')
    remove_files("__HamiltonianPMT.*")
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--writeham", "--mkprocar", "--noinv", "--mlo", *extra_args]),
            stdout="lwriteham")
    merge_files(pattern="PROCAR.UP.*", output_file="PROCAR.UP", remove_sources=True)
    merge_files(pattern="PROCAR.DN.*", output_file="PROCAR.DN", remove_sources=True)
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"mlo",
                               args=[target, *extra_args]), stdout="lmlo")
    if not args.nognuplot:
        for fname in ['bandplot_MLO.isp1.glt', 'bandplot_MLO.isp2.glt']:
            if Path(fname).exists():
                try:
                    run_gnuplot("-persist", fname, check=True)
                except FileNotFoundError:
                    print("Skip gnuplot")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog='job_mlo',
        description=(
            'Example:\n'
            "An example of usage: job_mlo si -np 4 [options for lmf/mlo]\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("extension",   help='Extension of the ctrl file') #extension is dummy. just to have similar interface with other scripts
    parser.add_argument("-c", "--cluster", help="cluster name", default="default", type=str)
    parser.add_argument("-np",         help='Number of MPI cores for lmf', default=8, type=int)
    parser.add_argument("--nognuplot", "--NoGnuplot", help="stop without drawing", action="store_true", default=False)
    parser.add_argument("-d", "--dir", help="execution directory (default: current directory)", default=".", type=str)

    args, extra_args = parser.parse_known_args()
    with contextlib.chdir(args.dir):
        cal_mlo(args, extra_args)


