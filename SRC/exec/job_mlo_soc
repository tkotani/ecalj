#!/usr/bin/env python3
# job_mlo_soc: MLO Hamiltonian generation with SOC as perturbation.
#   Steps:
#     1. lmf --quit=band (with --ctrlg:ham.so=1, full LS) to determine SOC-corrected Ef
#        -> written to 'efermi_soc' (--efermi=efermi_soc); efermi.lmf is not touched.
#     2. lmf --writeham ... --socmatrix (with --ctrlg:ham.so=0, scalar-rel) to write
#        __HamiltonianPMT + __HamiltonianPMTsoc.
#     3. mlo --socmatrix to build HamRsMLO + SOC-included MLO bands on symmetry line
#        (--efermi=efermi_soc: the MLO window is referenced to the SOC Ef, as before).
#     4. Rewrite ef= in bandplot_MLO.isp1.glt using efermi_soc.
#     Step 1 also draws the DFT bands with SOC under the same flags (lmf --band, bnd*.spin1, bandplot.isp1.glt),
#     so the bands of the directory are always the reference of the SOC MLO bands (2026-10-01 20:1x, user: the
#     job writes them; before, job_band without SOC was compared with them and GaAs looked 0.1 eV = Delta_SO/3 off).
#     Band files of an earlier run (bnd*.spin*, band_MLO_spin2.dat: with SOC every band is in spin1) are removed first.
#
# Common settings:
#   --ctrlg:ham.nspin=2 --ctrlg:ham.phispinsym=true
# Step-specific:
#   Step 1: --ctrlg:ham.so=1 (full LS, for Ef determination)
#   Step 2: --ctrlg:ham.so=0 --socmatrix (scalar-rel DFT, SOC matrix written separately)
#   Step 3: --socmatrix (tells mlo to read hammhso and apply as perturbation)
#
# Usage: job_mlo_soc gaas -np 8 [extra lmf/mlo flags]

import argparse
import contextlib
import re
import shutil
import subprocess
from pathlib import Path
from pylib.run_cmd import run_cmd, MPIParams
from pylib.utils import run_gnuplot
from pylib.utils import merge_files, remove_files

EXEC_DIR = Path(__file__).parent

# TOML-only mode: runtime overrides use --ctrlg:<toml-path>=<value>
# (m_toml_override; the programs stop on the older -v...= / --toml. forms).
COMMON_FLAGS = ["--ctrlg:ham.nspin=2", "--ctrlg:ham.phispinsym=true"]
EF_FLAGS    = ["--ctrlg:ham.so=1"]
WRITE_FLAGS = ["--ctrlg:ham.so=0", "--socmatrix"]
MLO_FLAGS   = ["--ctrlg:ham.nspin=2", "--ctrlg:ham.phispinsym=true", "--socmatrix"]

def read_eferm(fname):
    # efermi.lmf first line: <Ef(Ry)> <vmag> # ...
    with open(fname) as f:
        first = f.readline().split()
    # Fortran D-format -> Python float
    return float(first[0].replace('D', 'E').replace('d', 'e'))

def update_glt_ef(glt_path, ef_ry):
    path = Path(glt_path)
    if not path.exists():
        return
    text = path.read_text()
    new_text = re.sub(r'ef\s*=\s*[-+\deE.DdPp]+', f'ef={ef_ry}', text, count=1)
    path.write_text(new_text)
    print(f"Updated ef={ef_ry} in {glt_path}")

def cal_mlo_soc(args, extra_args):
    target = args.extension
    mpi_size = args.np
    cluster = args.cluster
    remove_files("HamiltonianPMT.*")
    for f in [*Path('.').glob('bnd0*.spin*'), Path('band_MLO_spin2.dat')]:   # left over from a run without SOC
        f.unlink(missing_ok=True)

    # Step 1: SOC-corrected Fermi energy via full LS lmf --quit=band
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--quit=band", "--efermi=efermi_soc",
                                     *COMMON_FLAGS, *EF_FLAGS, *extra_args]),
            stdout="llmf_ef_soc")
    if Path("efermi_soc").exists():
        ef_soc = read_eferm("efermi_soc")
        print(f"SOC Fermi energy = {ef_soc} Ry (written to efermi_soc)")
    else:
        print("Warning: efermi_soc not created in Step 1; Ef update skipped.")
        ef_soc = None

    # Step 1b: the DFT bands with SOC on the symmetry lines, the reference of the MLO bands (same flags as step 1)
    if list(Path('.').glob(f'syml.{target}')) and ef_soc is not None:
        run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                                   args=[target, "--band", "--efermi=efermi_soc",
                                         *COMMON_FLAGS, *EF_FLAGS, *extra_args]),
                stdout="llmf_band")
        print("DFT bands with SOC written (bnd*.spin1, bandplot.isp1.glt; log llmf_band)")
    else:
        print(f"Warning: no syml.{target} (or no efermi_soc); the DFT bands with SOC are not drawn.")

    # Step 2: write scalar-rel H + SOC matrix
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--writeham", "--mkprocar", "--noinv", "--mlo",
                                     *COMMON_FLAGS, *WRITE_FLAGS, *extra_args]),
            stdout="lwriteham")
    merge_files(pattern="PROCAR.UP.*", output_file="PROCAR.UP", remove_sources=True)
    merge_files(pattern="PROCAR.DN.*", output_file="PROCAR.DN", remove_sources=True)

    # Step 3: MLO + SOC-as-perturbation bands on symmetry line
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"mlo",
                               args=[target, *MLO_FLAGS, "--efermi=efermi_soc", *extra_args]),
            stdout="lmlo")

    # Step 4: rewrite ef= in bandplot glt with SOC Ef
    if ef_soc is not None:
        update_glt_ef("bandplot_MLO.isp1.glt", ef_soc)
    run_bandcheck()

    if not args.nognuplot:
        for fname in ['bandplot_MLO.isp1.glt']:
            if Path(fname).exists():
                try:
                    run_gnuplot("-persist", fname, check=True)
                except FileNotFoundError:
                    print("Skip gnuplot")


def run_bandcheck():
    """Check of the MLO model against the DFT bands of the directory (mlo_bandcheck.py; 2026-10-01 21:1x): the error,
    and FAIL for a broken model (a deviation above 0.1 eV, a jump along a line, MLOs near linear dependence).
    Skipped without DFT bands (bnd*: job_band, or step 1b of job_mlo_soc). Never stops the job."""
    import glob, subprocess, sys
    if not glob.glob('bnd0*.spin1'):
        print("mlo_bandcheck: no DFT bands (bnd*) here; run job_band to check the model")
        return
    out = subprocess.run([sys.executable, str(EXEC_DIR / 'mlo_bandcheck.py'), '.'], capture_output=True, text=True)
    print(out.stdout.rstrip() or out.stderr.rstrip())

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog='job_mlo_soc',
        description=(
            'Example:\n'
            "  job_mlo_soc gaas -np 8 [extra options]\n"
            "Common flags: --ctrlg:ham.nspin=2 --ctrlg:ham.phispinsym=true\n"
            "Step 1 (Ef):      lmf --quit=band --ctrlg:ham.so=1  -> efermi_soc\n"
            "         (bands): lmf --band --ctrlg:ham.so=1  -> bnd*.spin1, the DFT reference with SOC\n"
            "Step 2 (writeham): lmf --writeham ... --ctrlg:ham.so=0 --socmatrix\n"
            "Step 3 (mlo):     mlo --socmatrix\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("extension",   help='Extension of the ctrl file')
    parser.add_argument("-c", "--cluster", help="cluster name", default="default", type=str)
    parser.add_argument("-np",         help='Number of MPI cores', default=8, type=int)
    parser.add_argument("--nognuplot", "--NoGnuplot", help="stop without drawing", action="store_true", default=False)
    parser.add_argument("-d", "--dir", help="execution directory (default: current directory)", default=".", type=str)

    args, extra_args = parser.parse_known_args()
    with contextlib.chdir(args.dir):
        cal_mlo_soc(args, extra_args)
