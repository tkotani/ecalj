#!/usr/bin/env python3
"""
gwscconv: convergence-aware wrapper around gwsc.

Repeatedly runs `gwsc 1 ...` until the band gap of the last 3 QSGW iterations
agrees within `--conv-tol` (eV) for 2 consecutive iterations, or `--max-iter`
total QSGW iters is reached.

Usage:
    gwscconv [gwsc-args...] [--conv-tol TOL] [--max-iter N]

The args after the wrapper's own options are forwarded to gwsc verbatim,
except that any `nloop` positional is overridden to 1 (gwscconv controls
the loop). The script auto-detects pre-existing QPU.<n>run snapshots so
it can resume from a partially converged state.

Convergence check uses the eV value from llmf's
"gap = X Ry = Y eV" line (the labeled-eV value, not the Ry-mislabeled
egap line in log.<target>).

Metals (2026-09-30): an iteration after which llmf prints no gap is judged by the
change of the QSGW eigenvalues instead: dmax = max |e_n - e_(n-1)| over the states
of QPU.<n>run and QPU.<n-1>run (column "eQP", relative to E_F) with |e| < 5 eV.
Converged when dmax < --conv-qp (default 0.03 eV) for 2 consecutive iterations.
Semiconductors are judged by the gap as before. --no-metal restores the old stop
(exit 3) when there is no gap.

Exit codes:
    0  converged or max-iter reached normally
    2  bad CLI
    3  (--no-metal) cannot read gap from llmf after a gwsc run
    >  whatever gwsc exited with on failure
"""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

GAP_RE = re.compile(r"gap =\s*[-\d.]+\s*Ry =\s*([-\d.]+)\s*eV")
# Do NOT resolve(): binaries live in the bin/ dir as symlinks (lmfa ->
# build/, gwsc -> SRC/exec/). Resolving jumps to SRC/exec where the Fortran
# binaries are absent. Keep the invoked path (bin/) like gwsc does, so
# gwsc -> EXEC_DIR/lmfa resolves to bin/lmfa.
EXEC_DIR = Path(__file__).parent
GWSC = EXEC_DIR / "gwsc"


def existing_iter() -> int:
    """Max n from QPU.<n>run files in cwd (same logic as gwsc)."""
    nums = []
    try:
        for s in os.listdir():
            if s.startswith("QPU.") and s.endswith("run"):
                core = s[4:-3]
                if core.isdigit():
                    nums.append(int(core))
    except FileNotFoundError:
        pass
    return max(nums) if nums else 0


def latest_gap_eV():
    """Return last 'gap = X Ry = Y eV' from llmf, or None."""
    try:
        last = None
        with open("llmf") as f:
            for line in f:
                m = GAP_RE.search(line)
                if m:
                    last = float(m.group(1))
        return last
    except FileNotFoundError:
        return None


QP_WINDOW_EV = 5.0


def read_qpu(path):
    """{(isp, q1, q2, q3, state): eQP (eV, relative to E_F)} from a QPU file."""
    d = {}
    isp = 0
    with open(path) as f:
        for line in f:
            if "isp=" in line:
                isp = int(line.split("isp=")[1].split()[0])
                continue
            w = line.split()
            # data line: q1 q2 q3 state SEx SExcore SEc vxc --- dSEnoZ eQP ...
            if len(w) >= 11 and w[3].isdigit() and re.match(r"^-?\d+\.\d+$", w[0]):
                try:
                    d[(isp, w[0], w[1], w[2], int(w[3]))] = float(w[10])
                except ValueError:
                    pass
    return d


def qp_change_eV(n):
    """max |eQP(n) - eQP(n-1)| over the states with |eQP| < QP_WINDOW_EV, or None."""
    try:
        cur = read_qpu(f"QPU.{n}run")
        prev = read_qpu(f"QPU.{n - 1}run")
    except FileNotFoundError:
        return None
    ch = [abs(cur[k] - prev[k]) for k in cur if k in prev and abs(cur[k]) < QP_WINDOW_EV]
    return max(ch) if ch else None


def main():
    ap = argparse.ArgumentParser(
        prog="gwscconv",
        allow_abbrev=False,
        add_help=False,
        description="Run gwsc until last-3 gap swing < tol or max-iter reached.",
    )
    ap.add_argument("--conv-tol", type=float, default=0.1,
                    help="convergence tol on max-min of last 3 iter gaps in eV (default 0.1)")
    ap.add_argument("--max-iter", type=int, default=10,
                    help="absolute max QSGW iter incl. pre-existing (default 10)")
    ap.add_argument("--conv-qp", type=float, default=0.03,
                    help="metals (no gap): tol on the max change of the eigenvalues within 5 eV of E_F "
                         "between two iterations, in eV (default 0.03)")
    ap.add_argument("--no-metal", action="store_true",
                    help="stop with exit 3 when llmf prints no gap (the behaviour before 2026-09-30)")
    ap.add_argument("--help-conv", action="store_true",
                    help="show gwscconv help and exit (gwsc --help is also forwarded)")
    args, rest = ap.parse_known_args()

    if args.help_conv:
        ap.print_help()
        sys.exit(0)

    # Strip user-supplied nloop (first non-option positional digit token), force to 1.
    # gwsc has value-taking options (-np N, -np2 N, -ppn N, -ppn2 N, -c CLUSTER);
    # their value-arguments must NOT be mistaken for nloop.
    VALUE_FLAGS = {"-np", "-np2", "-ppn", "-ppn2", "-c", "--cluster"}
    fwd = []
    replaced_nloop = False
    skip_next = False
    for tok in rest:
        if skip_next:
            fwd.append(tok)
            skip_next = False
            continue
        if tok in VALUE_FLAGS:
            fwd.append(tok)
            skip_next = True
            continue
        if not replaced_nloop and not tok.startswith("-") and tok.isdigit():
            print(f"gwscconv: ignoring user-supplied nloop={tok} (gwscconv loops 1-by-1)",
                  flush=True)
            fwd.append("1")
            replaced_nloop = True
        else:
            fwd.append(tok)
    if not replaced_nloop:
        # Prepend nloop=1 so gwsc's required positional is satisfied.
        fwd = ["1"] + fwd

    n0 = existing_iter()
    total_iter = n0
    history = []  # gaps observed in this run (eV); None for an iteration without a gap
    consec_ok = 0  # consecutive iters under tol (gap: last-3 swing; metal: QP change); need 2 to stop
    mode = None    # "gap" or "metal": the judgement of the last iteration (the count restarts when it changes)
    fmt = lambda x: "nogap" if x is None else f"{x:.4f}"
    print(f"=== gwscconv start: cwd={os.getcwd()} ===", flush=True)
    print(f"=== gwscconv: conv_tol={args.conv_tol} eV  max_iter={args.max_iter}  Iter0={n0} ===",
          flush=True)

    if total_iter >= args.max_iter:
        print(f"gwscconv: pre-existing iter {n0} already >= max_iter {args.max_iter}, nothing to do",
              flush=True)
        sys.exit(0)

    while total_iter < args.max_iter:
        print(f"\n--- gwscconv: launching gwsc (next iter -> {total_iter + 1}) ---", flush=True)
        cmd = [str(GWSC)] + fwd
        rc = subprocess.run(cmd).returncode
        if rc != 0:
            print(f"gwscconv: gwsc exited {rc}, abort", file=sys.stderr)
            sys.exit(rc)
        total_iter += 1
        g = latest_gap_eV()
        dqp = qp_change_eV(total_iter)
        dqp_s = "none" if dqp is None else f"{dqp:.4f}"
        if g is None:
            if args.no_metal:
                print("gwscconv: cannot read gap from llmf after gwsc, abort", file=sys.stderr)
                sys.exit(3)
            # Metal: judged by the change of the eigenvalues near E_F.
            if mode != "metal":
                mode, consec_ok = "metal", 0
            history.append(None)
            consec_ok = consec_ok + 1 if (dqp is not None and dqp < args.conv_qp) else 0
            print(f"gwscconv: iter {total_iter} no gap (metal): max QP change within {QP_WINDOW_EV} eV of E_F "
                  f"= {dqp_s} eV (tol {args.conv_qp}); consec under tol = {consec_ok}/2", flush=True)
            if consec_ok >= 2:
                print(f"=== gwscconv: CONVERGED at iter {total_iter} "
                      f"(metal: max QP change < {args.conv_qp} eV for 2 consecutive iters) ===", flush=True)
                break
            continue
        if mode != "gap":
            mode, consec_ok = "gap", 0
        history.append(g)
        tail = ", ".join(fmt(x) for x in history[-5:])
        print(f"gwscconv: iter {total_iter} gap = {g:.4f} eV  (recent: {tail}; "
              f"max QP change = {dqp_s} eV)", flush=True)
        if len(history) >= 3 and None not in history[-3:]:
            last3 = history[-3:]
            swing = max(last3) - min(last3)
            if swing < args.conv_tol:
                consec_ok += 1
            else:
                consec_ok = 0
            print(f"gwscconv: last-3 swing = {swing:.4f} eV (tol {args.conv_tol}); "
                  f"consec under tol = {consec_ok}/2", flush=True)
            # Require the swing to stay under tol for 2 consecutive iters before
            # declaring convergence (guards against a one-off small swing).
            if consec_ok >= 2:
                print(f"=== gwscconv: CONVERGED at iter {total_iter} "
                      f"(swing < {args.conv_tol} for 2 consecutive iters) ===", flush=True)
                break

    if total_iter >= args.max_iter:
        print(f"=== gwscconv: max_iter {args.max_iter} reached without convergence ===",
              flush=True)

    print(f"gwscconv: final iter = {total_iter}, history (eV) = "
          + ", ".join(fmt(x) for x in history), flush=True)


if __name__ == "__main__":
    main()
