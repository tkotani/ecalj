#!/usr/bin/env python3
import argparse
import contextlib
from pathlib import Path
from pylib.run_cmd import run_cmd, MPIParams

EXEC_DIR = Path(__file__).parent

def cal_fermisurface(args, extra_args):
    target = args.extension
    mpi_size = args.np
    cluster = args.cluster
    nk1 = args.vnk1
    nk2 = args.vnk2
    nk3 = args.vnk3
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--quit=band", '--skipbstruxinit',
                                     f"-vnk1={nk1}", f"-vnk2={nk2}", f"-vnk3={nk3}", *extra_args]), stdout="llmf_ef")
    nk1 = args.vnk1+1
    nk2 = args.vnk2+1
    nk3 = args.vnk3+1
    run_cmd(cluster, MPIParams(nprocs=mpi_size, command=EXEC_DIR/"lmf",
                               args=[target, "--fermisurface", "--skipbstruxinit", "-pr45",
                                     f"--emin={args.emin}", f"--emax={args.emax}",
                                     f"-vnk1={nk1}", f"-vnk2={nk2}", f"-vnk3={nk3}", *extra_args]), stdout="llmf_fs")

    print(f'OK! We got fermiup.bxsf (fermidn.bxsf) for {target}')
    print('Run $xcrysden --bxsf fermiup.bxsf')
    print('NOTE: current version do not use crystal symmetry... So it can be time-consuming(although k-parallel works).')

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog='job_fermisurface',
        description=(
            'Example:\n'
            "  job_fermisurface si -np 4 -vnk1=20 -vnk2=20 -vnk3=20 [options for lmf]\n"
            "  job_fermisurface si -np 4 -d /path/to/workdir -vnk1=20 -vnk2=20 -vnk3=20 [options for lmf]\n"
            " For example, [options for lmf] is '-vpwemax=4 -vgmax=15 -vxcfun=103'\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("extension",   help='Extension of the ctrl file') #extension is dummy. just to have similar interface with other scripts
    parser.add_argument("-c", "--cluster", help="cluster name", default="default", type=str)
    parser.add_argument("-np",         help='Number of MPI cores for lmf', default=8, type=int)
    parser.add_argument("-vnk1",       help='Number of k-point in 1st dimension', default=12, type=int)
    parser.add_argument("-vnk2",       help='Number of k-point in 2nd dimension', default=12, type=int)
    parser.add_argument("-vnk3",       help='Number of k-point in 3rd dimension', default=12, type=int)
    parser.add_argument('--emin',      type=float, default=-10, help='cut off energy in eV')
    parser.add_argument('--emax',      type=float, default= 10, help='cut off energy in eV')
    parser.add_argument("-d", "--dir", help="execution directory (default: current directory)", default=".", type=str)

    args, extra_args = parser.parse_known_args()

    with contextlib.chdir(args.dir):
        cal_fermisurface(args, extra_args)


